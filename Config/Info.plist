<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Many IPTV providers have no HTTPS. telly itself still refuses plain HTTP unless the user
	     allows it for their provider in Settings (HTTP.swift). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- telly://sync?code=… links, from the QR code another device shows. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.gettelly.telly.sync</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>telly</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>telly uses the camera only to read the QR code another device shows when you link them for sync.</string>
	<!-- Keeps sound playing for picture in picture; "processing" lets iOS wake telly overnight to
	     start downloads (Downloads.swift). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<!-- Export compliance (the user's decision, 2026-11-05), so App Store Connect doesn't ask on every
	     build: exempt under Note 4 to Category 5 Part 2 of the US EAR. telly's main purpose is playing
	     video; its encryption only supports that: HTTPS (Apple's), CryptoKit sealing sync and the
	     Keychain, and VLCKit's libgcrypt and mbedTLS for encrypted streams and protocols. VLC for iOS,
	     which ships the same VLCKit, makes the same declaration. Revisit if telly adds encryption of
	     its own for anything else. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.github.tellyteam.telly.downloads.overnight</string>
	</array>
</dict>
</plist>
